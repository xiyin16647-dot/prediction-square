# 复制本文件为 .env 后填入真实值
# 部署 Vercel 时需把这些都填到 Vercel 项目设置 → Environment Variables 里

# Neon Postgres 连接串（在 neon.tech 控制台拿）
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# JWT 签名密钥（生产环境必须改成随机长字符串，可用 `openssl rand -hex 32` 生成）
JWT_SECRET="dev-only-secret-change-in-production"

# 蚂蚁内网 LLM 网关 token（创建市场时 AI 推荐字段用），不填则相关按钮报错
ANTCHAT_TOKEN=""
ANTCHAT_MODEL="DeepSeek-V4-Flash"

# Vercel Cron 调用 /api/cron/* 时的 Bearer token（生产必填，
# 用 `openssl rand -hex 24` 生成；同一个值同时填到 Vercel 环境变量）
CRON_SECRET=""
